{
  "manifest_version": 3,
  "name": "YouTube Study Notes",
  "version": "1.2.0",
  "description": "AI study notes from YouTube transcripts. Free with Ollama. Export Markdown/PDF, flashcards, and history.",
  "permissions": ["storage", "activeTab", "downloads", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Open Study Notes panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content/transcript-fetch.js", "content/content.js", "content/features.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
